load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")

genrule(
    name = "gen_logger_pb",
    srcs = ["schema.txt"],
    outs = ["_logger.pb.go"],
    cmd = """awk 'BEGIN { print "// Code generated by schema-gen. DO NOT EDIT."; print "package schema"; print "" } NR==1 { printf "type %s struct {\\n", $$1 } NR>1 { split($$0, a, ":"); printf "\\t%s %s\\n", toupper(substr(a[1],1,1)) substr(a[1],2), a[2] } END { print "}" }' $(location schema.txt) > $@""",
)

write_source_files(
    name = "write_logger_pb",
    files = {
        "logger.pb.go": ":gen_logger_pb",
    },
)
